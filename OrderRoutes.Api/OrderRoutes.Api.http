@host = https://localhost:7180

### ---------- Masters ----------
GET {{host}}/api/masters/status-types

###
GET {{host}}/api/masters/statuses?typeId=1&search=proforma

###
GET {{host}}/api/masters/start-rule-options

###
GET {{host}}/api/masters/customers?search=north&page=1&pageSize=20

### ---------- Order routes ----------
GET {{host}}/api/order-routes?state=Active&statusTypeId=1

###
GET {{host}}/api/order-routes/1

### Create
POST {{host}}/api/order-routes
Content-Type: application/json

{
  "name": "Export Order to Payment",
  "state": "Draft",
  "statusTypeId": 1,
  "startRules": {
    "matchMode": "All",
    "entities": ["SIPL"],
    "exportAddresses": ["AD0510001"],
    "orderTypes": ["EXPORT", "MERCHANT_EXPORT"],
    "shipmentModes": ["FCL", "LCL"],
    "incoterms": ["FOB", "CIF"],
    "shipBill": "Any"
  },
  "steps": [
    { "kind": "Waypoint", "statusId": 1,  "assignee": "CRM desk", "slaHours": 4 },
    { "kind": "Task",     "statusId": 45, "assignment": "RoundRobin", "assignee": "CRM team", "slaHours": 8 },
    { "kind": "Waypoint", "statusId": 2,  "assignee": "CRM desk", "slaHours": 4 },
    { "kind": "Waypoint", "statusId": 22, "assignee": "CRM desk", "slaHours": 2 },
    { "kind": "Waypoint", "statusId": 3,  "assigneeType": "Customer", "assignee": "Buyer contact", "slaHours": 48 },
    { "kind": "Approval", "statusId": 26, "assignment": "RoundRobin", "assignee": "Department heads", "slaHours": 24,
      "sendBack": [
        { "statusId": 29, "assignee": "Logistics", "slaHours": 8 },
        { "statusId": 31, "assignee": "Logistics", "slaHours": 24 }
      ] },
    { "kind": "Waypoint", "statusId": 4,  "assignee": "Production planning", "slaHours": 8 },
    { "kind": "Waypoint", "statusId": 5,  "assignee": "Logistics", "slaHours": 2 },
    { "kind": "Waypoint", "statusId": 11, "assignee": "Accounts", "slaHours": 720 }
  ]
}

### Update (send the full definition plus rowVersion from GET)
PUT {{host}}/api/order-routes/1
Content-Type: application/json

{
  "name": "Export Order to Payment",
  "state": "Draft",
  "statusTypeId": 1,
  "rowVersion": "AAAAAAAAB9E=",
  "startRules": { "matchMode": "All", "entities": ["SIPL"], "orderTypes": ["EXPORT"] },
  "steps": [
    { "kind": "Waypoint", "statusId": 1, "assignee": "CRM desk", "slaHours": 4 },
    { "kind": "Waypoint", "statusId": 5, "assignee": "Logistics", "slaHours": 2 }
  ]
}

### Activate / deactivate
PUT {{host}}/api/order-routes/1/state
Content-Type: application/json

{ "state": "Active", "rowVersion": "AAAAAAAAB9E=" }

### Duplicate as a draft
POST {{host}}/api/order-routes/1/duplicate

### Which route does a new order follow?
POST {{host}}/api/order-routes/match
Content-Type: application/json

{
  "statusTypeId": 1,
  "entity": "SIPL",
  "exportAddress": "AD0510001",
  "orderType": "EXPORT",
  "shipmentMode": "FCL",
  "incoterm": "FOB",
  "customer": "C1001",
  "shipToCountry": "GB",
  "billToCountry": "GB",
  "shipToParty": "C1001",
  "billToParty": "C1001"
}
